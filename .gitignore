# Generated by Cargo
# will have compiled files and executables
debug
/target
**/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# OS / editor
.DS_Store
*.swp
*.swo
*~

# Environment and local config
.env

# Local Claude Code overrides — keep .claude/settings.json tracked (ships
# with the OSS repo so the Stop hook is wired on first clone). Ignore the
# user-private overrides only.
.claude/settings.local.json
.claude/.credentials.json
.claude/cache/
.claude/projects/

# team_mode_mcp runtime data directories (both old and new)
.agent-teams/
.team-mode-data/

# Cargo.lock is checked in for binaries but not for libraries
Cargo.lock

# team-mode runtime artifacts
.agent-teams/
/lead_pending.jsonl
/.lead-pending-wake.log
/.lead_pending.lock
/.lead-pending.lock
/.lead-sessions.json
/.ancestor-cache.json
/.stop-hook-cooldown

# Playwright MCP output (ephemeral test artifacts)
.playwright-mcp/

# Scratch / working notes not meant for the repo
docs/中间内容.txt

# Local-only working tree leftovers
/test-wake/
/mcp_server.log

# Python bytecode cache (golden_rules.py / run_ci.py imports)
**/__pycache__/

# Manual UI verification screenshots — captured ad-hoc during testing,
# not meant for the repo.
/webui-*.png

# In-progress lead+team planning workspace. The .plans/ tree is per-CC
# session scratch (per-worker progress.md / findings.md / task_plan.md);
# committed to share across sessions in one CC, but kept out of the
# public repo since paths bake in the contributor's local environment.
/.plans/

# Generated by scripts/setup.sh from .mcp.json.template — has the user's
# absolute path baked in, so it's per-machine. The TEMPLATE is tracked.
/.mcp.json

# NOTE: vendor/ is intentionally TRACKED — Cargo.toml [patch.crates-io] points
# at vendor/* paths, so removing vendor would break `cargo build` for fresh clones.
