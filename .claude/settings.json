{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/lead-pending-async-wake.js",
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/lead-pending-mid-turn.js"
          }
        ]
      }
    ]
  }
}
